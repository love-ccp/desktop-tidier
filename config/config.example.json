{
  "$schema": "./schema.json",
  "watcher": {
    "source_dir": "",
    "extensions": ["enbx", "pptx", "ppt", "doc", "docx", "pdf", "wps", "et", "dps", "zip"],
    "min_age_days": 7,
    "debounce_ms": 400,
    "scan_interval_secs": 172800
  },
  "storage": {
    "inbox_dir": "storage/待分类",
    "course_dir": "storage/课件库",
    "archive_dir": "storage/归档",
    "recycle_after_archive": true
  },
  "classifier": {
    "lexicon_path": "lexicon.txt",
    "lexicon_encoding": "auto",
    "default_group": "未分类"
  },
  "archiver": {
    "interval_hours": 168,
    "zip_level": 6,
    "rename_pattern": "{date}_{seq}_desktop-tidier.zip",
    "max_archives": 0,
    "max_total_bytes": 0,
    "min_new_files": 1
  },
  "indexer": {
    "md_path": "storage/台账.md",
    "md_encoding": "auto",
    "entry_format": "{no}. {filename} - {group} - {date}"
  },
  "logger": {
    "file": "logs/desktop-tidier.log",
    "level": "info",
    "max_bytes": 1048576
  },
  "timesync": {
    "enabled": true,
    "servers": ["https://www.baidu.com"],
    "interval_hours": 1,
    "timeout_secs": 10
  },
  "notify": {
    "enabled": true,
    "app_name": "课件整理助手"
  },
  "concurrency": {
    "max_parallel_ops": 4
  }
}
