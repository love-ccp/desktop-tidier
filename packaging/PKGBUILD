# Maintainer: course-organizer-dev <course-organizer-dev@localhost>
# Arch Linux 打包（PKGBUILD）。构建产物：/usr/bin/desktop-tidier + 桌面入口。
# 使用：makepkg -si（在仓库根目录，source 需替换为实际 tarball/git 源）。

pkgname=desktop-tidier
pkgver=0.1.0
pkgrel=1
pkgdesc="希沃白板课件定期整理后台工具（单进程纯 Rust，无 GUI 窗口，托盘常驻）"
arch=('x86_64')
url=""
license=('MIT')
makedepends=('cargo')
depends=('glibc' 'gcc-libs')
# 正式发布时改为 tarball 或 git 源；此处示例直接使用当前目录。
source=()
sha256sums=()

build() {
  cargo build --release --locked
}

package() {
  install -Dm755 target/release/desktop-tidier "$pkgdir/usr/bin/desktop-tidier"
  install -Dm644 packaging/desktop-tidier.desktop \
    "$pkgdir/usr/share/applications/desktop-tidier.desktop"
  install -Dm644 packaging/desktop-tidier.service \
    "$pkgdir/usr/lib/systemd/user/desktop-tidier.service"
}
